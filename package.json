{
  "name": "infini-ai",
  "version": "3.0.0",
  "description": "INFINI AI — a chatbot with no language model: a built-in rule-based brain for conversation, memory and common sense, live web retrieval with citations for knowledge, and research runs that read and classify hundreds of pages. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=18.17" },
  "main": "engine/index.js",
  "bin": { "infini": "cli.js" },
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "ask": "node cli.js",
    "test": "node --test test/unit.test.js test/brain.test.js test/research.test.js",
    "test:ui": "node test/ui-smoke.mjs",
    "bench": "node bench/intelligence.js",
    "bench:resources": "node bench/resources.js",
    "bench:research": "node bench/research.js",
    "audit:security": "node bench/security.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
