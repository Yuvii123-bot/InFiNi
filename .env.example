# INFINI AI — every setting is optional. No key is required; there is no LLM key because there is no LLM.
PORT=8787
HOST=0.0.0.0
# Contact (URL or e-mail). Sent only to Wikimedia's servers, in the User-Agent, as their API rules ask;
# identified clients get 200 requests/min instead of 10. Every other site receives a generic User-Agent.
INFINI_CONTACT=
# Who built this deployment. Used by the built-in brain when someone asks "who made you" (at most 60 characters).
# Empty = "an independent developer".
INFINI_CREATOR=
# Optional search providers (keys stay on the server and are never sent to the browser).
# None of these needs a payment method except Brave. Without any of them, Firecrawl's keyless search is used
# (small daily allowance per server address), then DuckDuckGo HTML, Mwmbl and Wiby.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEARXNG_URL=
MARGINALIA_API_KEY=
# Brave asks for a payment method even for its free monthly credit — optional
BRAVE_API_KEY=
STACKEXCHANGE_KEY=
# Comma-separated provider ids to switch off, e.g. ddg_html,wiby
DISABLE_PROVIDERS=
# Extra RSS/Atom feeds for news questions (comma-separated URLs)
EXTRA_FEEDS=
# Limits
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=8
MAX_CONCURRENT_ASKS=4
FETCH_TIMEOUT_MS=7000
FETCH_MAX_BYTES=1500000
CACHE_MAX_MB=24
CACHE_TTL_MIN=15
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Set to 1 to allow embedding the app in an iframe on another origin
ALLOW_EMBED=0
# Set to 1 to log question text (off by default for privacy)
LOG_QUESTIONS=0
