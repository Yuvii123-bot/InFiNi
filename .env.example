# INFINI AI — every setting is optional. No key is required; there is no LLM key because there is no LLM.
PORT=8787
HOST=0.0.0.0
# Contact (URL or e-mail). Sent only to Wikimedia's servers, in the User-Agent, as their API rules ask;
# identified clients get 200 requests/min instead of 10. Every other site receives a generic User-Agent.
INFINI_CONTACT=
# Who built this deployment. Used by the built-in brain when someone asks "who made you" (at most 60 characters).
# Who built INFINI AI; the brain gives this name when asked "who made you". Empty = "Nepal369".
INFINI_CREATOR=
# Optional search providers (keys stay on the server and are never sent to the browser).
# None of these needs a payment method except Brave. Without any of them, Firecrawl's keyless search is used
# (small daily allowance per server address), then DuckDuckGo HTML, Mwmbl and Wiby.
# LangSearch: free key, no payment method; a daily allowance counted in tokens of returned text (renews at 00:00 UTC).
# Asked before Tavily, whose free quota is monthly. Only links and 320 characters of text per result are requested.
LANGSEARCH_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
SEARXNG_URL=
MARGINALIA_API_KEY=
# Brave asks for a payment method even for its free monthly credit — optional
BRAVE_API_KEY=
STACKEXCHANGE_KEY=
# Scholarly abstracts come from OpenAlex and Crossref. OpenAlex answers without a key only on a small daily allowance
# (and pauses anonymous search under load); a free key from https://openalex.org/settings/api lifts that.
# Crossref and Europe PMC need no key.
OPENALEX_API_KEY=
# Comma-separated provider ids to switch off, e.g. ddg_html,wiby
DISABLE_PROVIDERS=
# Extra RSS/Atom feeds for news questions (comma-separated URLs)
EXTRA_FEEDS=
# Research runs ("do deep research on …", or Depth: Research). One run reads up to RESEARCH_MAX_PAGES pages for up to
# RESEARCH_MAX_SECONDS seconds and uses roughly 300 MB of memory. On serverless hosts keep the seconds well below the
# platform's function limit (Vercel: 300 s). RESEARCH_MODE=0 switches research runs off (they are answered at depth "deep").
RESEARCH_MODE=1
RESEARCH_MAX_PAGES=1500
RESEARCH_MAX_SECONDS=170
# searches one research run may make on a service with a metered key (Tavily, Brave), on top of the first round.
# More searches bring more leads (and more pages read) and use up a monthly quota faster.
RESEARCH_KEYED_SEARCHES=5
# searches one research run may make on LangSearch (0 to 40). One search returns up to 50 results and costs about 3,000 tokens.
RESEARCH_LANGSEARCH_SEARCHES=12
# least time (ms) between the starts of two requests to LangSearch (new accounts are allowed 5 requests per second).
# LANGSEARCH_GAP_MS=250
# pages fetched at the same time during a research run
CRAWL_CONCURRENCY=40
# research runs side by side on one server instance / started per hour on one instance / per client address per hour
MAX_CONCURRENT_RESEARCH=2
RESEARCH_PER_HOUR=12
RESEARCH_PER_CLIENT_PER_HOUR=6
# Limits (a question at depth "deep" costs 2 of a client's allowance, a research run 4)
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_BURST=8
MAX_CONCURRENT_ASKS=4
FETCH_TIMEOUT_MS=7000
FETCH_MAX_BYTES=1500000
CACHE_MAX_MB=24
CACHE_TTL_MIN=15
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Set to 1 to allow embedding the app in an iframe on another origin
ALLOW_EMBED=0
# Set to 1 to log question text (off by default for privacy)
LOG_QUESTIONS=0

# Least time (ms) between the starts of two requests to Crossref (its public pool allows 3 requests per second).
# CROSSREF_GAP_MS=380

# ---------------------------------------------------------------------------------------------------------------------
# Infinity LLM (the project's own neural language model; docs/INFINITY-LLM.md)
# ---------------------------------------------------------------------------------------------------------------------
# 0 = do not load the model: replies come from the built-in rules and the web pipeline, as before version 4.
INFINI_LLM=1
# Where the learning system keeps its state (corpus, datasets, checkpoints, model versions). Needs a writable disk.
# Empty = data/llm inside the repository. A host without one serves the model published in model/.
INFINI_LLM_DIR=
# Protects the training controls on the learning page (pause, start, roll back, settings). At least 16 characters.
# Unset = the controls are disabled. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INFINI_ADMIN_TOKEN=
# A reply whose mean log-probability per token is below this is not shown; the built-in rules answer instead (-20..0).
INFINI_LLM_MIN_LOGPROB=-1.6
# A generated reply is shown only if its word overlap (F1, 0..1) with a correct rule-based reply to the same message
# reaches this value; otherwise the rule-based reply is shown. 0 switches the check off (not recommended).
INFINI_LLM_MIN_AGREEMENT=0.6
# 0 = this host never trains (it still serves the model). 0 for the scheduler = cycles start only when an admin asks.
INFINI_LEARNING=1
INFINI_LEARNING_SCHEDULER=1
# Python with PyTorch for training. Empty = .venv/bin/python in the repository, then python3.
INFINI_PYTHON=

# ---------------------------------------------------------------------------------------------------------------------
# The always-on learning worker (node learning/worker.mjs; docs/WORKER.md)
# ---------------------------------------------------------------------------------------------------------------------
# On the SERVING side (for example Vercel): the address of the worker's model channel. The server looks there every
# INFINI_MODEL_CHANNEL_SECONDS, checks the checksums, runs the model's self-test and then answers with the new version.
# No redeploy. With a GitHub release as the channel: https://github.com/<owner>/<repo>/releases/download/infinity-model
INFINI_MODEL_CHANNEL=
INFINI_MODEL_CHANNEL_SECONDS=300
# Where received models are kept (empty = the system's temporary directory).
INFINI_MODEL_CHANNEL_DIR=

# On the WORKER side: where approved models and the worker's status are published. Any combination.
#   a directory (a volume shared with the server, or the document root of a static web server)
INFINI_PUBLISH_DIR=
#   the assets of a GitHub release (owner/repository; needs GITHUB_TOKEN with "contents: write")
INFINI_PUBLISH_GITHUB=
INFINI_PUBLISH_TAG=infinity-model
# Hosts without a permanent disk: keep the whole state as one archive in a GitHub release (owner/repository), or in a file.
INFINI_STATE_GITHUB=
INFINI_STATE_TAG=infinity-state
INFINI_STATE_ARCHIVE=
# End the worker by itself after this many seconds (0 = never). Used by hosts that limit how long a process may live.
INFINI_WORKER_MAX_RUNTIME=0
# Shown on the dashboard: where this worker runs.
INFINI_WORKER_WHERE=
# Raises the GitHub API allowance when collecting openly licensed text from public repositories (read-only, no scopes).
GITHUB_TOKEN=
