# INFINI AI — the learning worker as a container: Node, Python and PyTorch (CPU), and this repository.
# One permanent process (learning/worker.mjs): it discovers, verifies, trains, evaluates, promotes and publishes by
# itself, and continues where it stopped after a restart. Its state lives in /data — mount a volume there.
#
#   docker build -f Dockerfile.worker -t infinity-worker .
#   docker run -d --restart unless-stopped -v infinity-state:/data --name infinity-worker infinity-worker
FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates tar \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
 && /opt/venv/bin/pip install --no-cache-dir numpy
WORKDIR /app
COPY package.json ./
COPY engine ./engine
COPY learning ./learning
COPY llm ./llm
COPY model ./model
ENV NODE_ENV=production INFINI_LLM_DIR=/data/llm INFINI_PYTHON=/opt/venv/bin/python INFINI_PUBLISH_DIR=/data/channel
RUN mkdir -p /data && chown -R node:node /data
USER node
VOLUME /data
# healthy while the worker's heartbeat is younger than three minutes
HEALTHCHECK --interval=60s --timeout=10s --start-period=120s CMD node learning/cli.mjs alive || exit 1
STOPSIGNAL SIGTERM
CMD ["node", "--max-old-space-size=768", "learning/worker.mjs"]
